# Questions the node's installer must answer for this site — NOT settings.
#
# Values are intentionally empty unless a default is written. `npm run services:install`
# reads this file, and the `# kind:` line above a group of variables tells it WHO answers:
#
#   derived — the installer knows the answer itself (assigned port, neighbours' addresses)
#   secret  — the installer generates a random value once and writes it to BOTH ends
#   own     — this site's own setting: the default is written here, and a value once changed
#             (by a person, or by the core through this site's settings door) survives a reinstall.
#             The site never takes its settings from the core: it must live if the core is gone.
#   foreign — a third-party key: the installer names it and says what breaks without it
#
# The generated file is `.env.local` in this folder (Next reads it by convention).
# Keys you add there yourself survive a reinstall.
#
# The list was derived from the code (every process.env the site reads), not from memory.

# ─── Where this site stands and who its neighbours are ───────────────────────

# kind: derived
# Port this site listens on. The node assigns it from the block 24680-25679.
PORT=
# Address of the node core that owns the architect pages; /<lang>/architect/* redirects there.
ARCHITECT_URL=
# The node's auth element — the only one that signs people in.
AUTH_SERVICE_URL=
# The node's data element. Its presence is what makes the site use the data door
# instead of opening a database file of its own.
REMOTE_DATA_URL=
# Absolute path to this site's DESIGN-CONFIG/design-config.json. The standalone server runs from
# .next/standalone, so a relative path would write the settings INSIDE the build, and the next
# build would erase them. Read by the build and by the settings door alike.
DESIGN_CONFIG_PATH=
# The same, for APP-CONFIG/app-config.json, PLATFORM-CONFIG/platform-config.json and the folder APP-CONFIG/legal (cookie
# banner and legal texts). ✗ Measured 2026-09-25: without them the built server read the copies the build had placed
# INSIDE itself, so an edit of these files on disk was invisible until the next build.
APP_CONFIG_PATH=
PLATFORM_CONFIG_PATH=
LEGAL_CONFIG_DIR=
# The element's own folder, absolute (node step 330-3): `lib/page-tree.ts` reads the page texts (`app/**/_data`, `_pages`)
# from it at run time. ✗ Measured 2026-09-28: without it the built server read the copies inside the build, and a text
# edit stayed invisible even after `npm run pages:refresh` answered 200.
# kind: derived
ELEMENT_DIR=

# The node's settings element (299-6): it keeps the owner's settings and gives them over MCP (<url>/mcp); this site
# takes them of its own will with SETTINGS_SECRET — once, at server start. Empty — no such element: own files apply.
CONFIG_SERVICE_URL=
# Absolute path to this site's data folder at the node (data/services/<id>): the last received copy of the project
# settings lives there, outside the build, so a rebuild or a reinstall does not erase it.
SERVICE_DATA_DIR=

# Absolute path to the NODE's logs/domain.json (the connected domain). Given by the node installer. Without it the
# built server (which runs from its build folder) cannot see the domain, and «Sign in» leads a visitor to 127.0.0.1.
NODE_DOMAIN_FILE=

# ─── The key to the data door ────────────────────────────────────────────────

# kind: secret
DATA_SECRET=
# The key of this site's settings door (/api/settings/*): the node core presents it to read and
# change this site's settings. Generated once by the installer and written to both ends.
SETTINGS_SECRET=

# ─── This site's own settings ────────────────────────────────────────────────

# kind: derived
# Where a visitor's browser goes to sign in (the auth element as the browser sees it).
NEXT_PUBLIC_AUTH_URL=

# kind: own
NEXT_PUBLIC_APP_TITLE=Fractera Light
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,ru
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Languages open to search engines besides English and the default one (step 340): comma list, written by the node from
# APP-CONFIG languages.indexed. Empty = only English + the default language.
NEXT_PUBLIC_INDEXED_LANGUAGES=
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_APP_SHELL_AUTH=

# ─── Third-party keys ────────────────────────────────────────────────────────

# kind: foreign
# Voice input and translations. Without it those two features answer that no key is set.
OPENAI_API_KEY=

# kind: derived
# The node's design element (step 309): this service takes the project design (colours, fonts, type, shapes, block
# settings) from it over MCP (<url>/mcp) at start and on its signal, with SETTINGS_SECRET. Empty — no such element: own
# DESIGN-CONFIG applies.
DESIGN_SERVICE_URL=

# ─── 550: the object storage of the node (media of the former data service) ──

# kind: derived
# The database element of the node. The address of every stored file is written on ITS address (/media/<id>/file):
# consumers call /media there, and it passes the request here.
DATA_URL=
# The no-sign-in mode of the server line; a node leaves it empty.
FRACTERA_IP_NODOMAIN_MODE=
